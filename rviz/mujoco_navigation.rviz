# Generated navigation view (keep the three ATS RViz configs in sync; this simulation view alone
# also draws the vehicle model and ROG-Map's native voxel / ESDF clouds).
# Global: fused RC-ESDF; local: ROGMap range boxes plus its native clouds (group "ROG-Map native voxels");
# paths: JPS -> MINCO -> MPC horizon/prediction, all in odom (ground z = 0).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Robot Pose (odom -> gimbal_yaw_odom)
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.04
        Color: 255; 25; 0
        Head Length: 0.25
        Head Radius: 0.12
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /localization
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: 'LIO Odometry /odometry (Point-LIO, green)'
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.04
        Color: 40; 200; 60
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.45
        Shaft Radius: 0.04
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /odometry
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: 'Ground Truth (simulation only, blue)'
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.04
        Color: 40; 120; 255
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.45
        Shaft Radius: 0.04
        Value: Arrow
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /simulation/ground_truth/odometry
      Value: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 0; 220; 255
      Decay Time: 0
      Enabled: true
      Name: 'Registered Scan /registered_scan (odom frame)'
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /registered_scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ''
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Robot Model
      TF Prefix: ''
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.45
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: S3 persistent odom layer
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rog_map/odom_layer
      Use Timestamp: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: 'ESDF Cloud: Magenta Obstacle / Orange Footprint Band / Green Clearance / Violet Terrain'
      # Signed distance of the planning snapshot that JPS/MINCO use; encoded only while subscribed.
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.1
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rog_map_adapter/viz/esdf_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Planning Grid (JPS occupancy)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rog_map_adapter/viz/planning_grid
      Use Timestamp: false
      Value: true
    - Alpha: 0.3
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
      Value: true
    # ROG-Map native 3D diagnostics (simulation only; the node builds a cloud only while a display
    # subscribes, core.visualization.* is not involved).  Local box = core.visualization.range around
    # the robot, the purple/green boxes of the bounds display below.  Publishers are Best Effort.
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 0; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ROG-Map occupied voxels (/rog_map/occ)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.08
          Style: Boxes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/occ
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.45
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 145; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ROG-Map inflated occupied voxels (/rog_map/inf_occ)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.08
          Style: Boxes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/inf_occ
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 128; 128; 128
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: ROG-Map unknown voxels (/rog_map/unk)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.08
          Style: Boxes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/unk
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.65
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Name: ROG-Map 3D ESDF slice z=0.15 m (/rog_map/esdf, intensity = distance m)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.05
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/esdf
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 0.78
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: false
          Name: ROG-Map local voxel state, debug (/rog_map/viz)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.09
          Style: Boxes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/viz
          Use Fixed Frame: true
          Value: false
      Enabled: true
      Name: ROG-Map native voxels (local box)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 'ROGMap Bounds: Orange Local / Green Update'
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/bounds
      Value: true
    - Alpha: 0.85
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 160; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.05
      Name: Global Planning / JPS Search Path
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Color: 0; 160; 0
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /minco/raw_path
      Value: true
    - Alpha: 0.95
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 230; 20; 30
      Enabled: true
      Line Style: Billboards
      Line Width: 0.10
      Name: Local Control / MINCO Timed Reference
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 230; 20; 30
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /minco/reference_path
      Value: true
    - Alpha: 0.95
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 140; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: MPC Follow / Active Reference Horizon
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 140; 0
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ats_swerve_mpc/reference_horizon
      Value: true
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 90; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.05
      Name: MPC Prediction / iLQR Follow Rollout
      Offset:
        X: 0
        Y: 0
        Z: 0.12
      Pose Color: 30; 90; 255
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ats_swerve_mpc/predicted_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 42.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 10.9
        Y: -1.4
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.712
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  X: 60
  Y: 60
