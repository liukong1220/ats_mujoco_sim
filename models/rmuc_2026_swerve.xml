<mujoco model="rmuc_2026_swerve">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <material name="grid" rgba="0.18 0.19 0.19 1"
              reflectance="0.08" specular="0.05"/>
    <material name="body_blue" rgba="0.08 0.24 0.42 1"/>
    <material name="body_dark" rgba="0.05 0.07 0.09 1"/>
    <material name="gimbal_dark" rgba="0.07 0.075 0.08 1"/>
    <material name="module_metal" rgba="0.48 0.52 0.55 1"/>
    <material name="wheel_rubber" rgba="0.02 0.02 0.018 1"/>
    <material name="front_marker" rgba="0.9 0.1 0.08 1"/>
    <material name="lidar_black" rgba="0.02 0.025 0.03 1"/>
    <material name="lidar_window" rgba="0.05 0.8 0.95 0.55"/>
    <material name="tof_body" rgba="0.04 0.04 0.045 1"/>
    <material name="tof_window" rgba="0.9 0.75 0.08 0.65"/>
    <material name="rmuc_2026_field" rgba="0.58 0.58 0.55 1"
              reflectance="0.0" specular="0.05" shininess="0.0"
              emission="0.08"/>
    <mesh name="mid360_mesh" file="meshes/mid360.obj"/>
    <!--
      Generated directly from the corrected
      src/ats_sentry_bringup/map/rmuc_2026.stl.
      The generated hfield is mirrored up-down to match the Nav2/RViz
      occupancy image orientation.
      MuJoCo compiles a non-convex OBJ/STL mesh into a convex hull for
      collision, so the RMUC field is represented as a native hfield for
      raycast and contact fidelity. Field bounds after centering:
      x [-14.575, 14.575], y [-8.027637, 8.027637], z [0.000, 1.804134].
    -->
    <hfield name="rmuc_2026_field_hfield" size="14.575 8.027637 0.292571 0.030"
            file="rmuc_2026_height.png"/>
    <!-- Kept installed for offline inspection or future mesh-decomposition work. -->
    <mesh name="rmuc_2026_field_stl" file="meshes/rmuc_2026.stl"/>
  </asset>

  <default>
    <joint damping="0.02" armature="0.002"/>
    <geom friction="3 0.02 0.005" condim="3" margin="0.001"/>
    <default class="steer_joint">
      <joint type="hinge" axis="0 0 1" range="-3.14159 3.14159"
             damping="0.25" armature="0.01"/>
    </default>
    <default class="wheel_joint">
      <joint type="hinge" axis="0 1 0" damping="0.01" armature="0.004"/>
    </default>
    <default class="wheel_geom">
      <geom type="cylinder" size="0.075 0.025" quat="0.7071068 0.7071068 0 0"
            material="wheel_rubber" mass="1.2" priority="1" group="0"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 5" dir="-0.3 -0.4 -1"/>
    <geom name="floor" type="plane" pos="0 0 -0.030" size="15.0 8.5 0.05"
          material="grid" contype="0" conaffinity="0"/>
    <geom name="rmuc_2026_field" type="hfield" hfield="rmuc_2026_field_hfield"
          pos="0 0 0"
          material="rmuc_2026_field" condim="3" friction="1.2 0.08 0.02"
          contype="1" conaffinity="1"/>

    <!--
      Coordinate convention:
      x points forward, y points left, z points upward.
      The base_link body is published as gimbal_yaw_odom. The real robot
      envelope is 600 x 500 x 230 mm, split around that frame as:
      chassis z [-0.10, 0.00] m and gimbal z [0.00, 0.13] m.
    -->
    <body name="base_link" pos="0 0 0.18">
      <freejoint/>
      <inertial pos="0 0 0" mass="35"
                diaginertia="1.23 1.93 2.41"/>

      <geom name="base_size_envelope" type="box" pos="0 0 0.015"
            size="0.300 0.250 0.115"
            rgba="0.1 0.4 0.7 0.12" contype="0" conaffinity="0"
            group="0"/>
      <geom name="base_collision" type="box" pos="0 0 0.015"
            size="0.300 0.250 0.115"
            rgba="0.1 0.4 0.7 0.0" contype="1" conaffinity="1"
            group="3"/>
      <geom name="chassis_body" type="box" pos="0 0 -0.050"
            size="0.300 0.250 0.050" material="body_blue"
            contype="0" conaffinity="0" group="0"/>
      <geom name="gimbal_body" type="box" pos="0 0 0.065"
            size="0.120 0.120 0.065" material="gimbal_dark"
            contype="0" conaffinity="0" group="0"/>
      <geom name="gimbal_yaw_ring" type="cylinder" pos="0 0 0.010"
            size="0.135 0.010" material="module_metal"
            contype="0" conaffinity="0" group="0"/>
      <geom name="front_marker" type="box" pos="0.296 0 -0.015"
            size="0.006 0.205 0.050" material="front_marker"
            contype="0" conaffinity="0" group="0"/>

      <body name="lidar_link" pos="-0.200 0.000 0.000"
            quat="0.8616291604 0 0 -0.5075383630">
        <geom name="mid360_visual" type="mesh" mesh="mid360_mesh"
              quat="0 0 0 1" material="lidar_black"
              density="0" contype="0" conaffinity="0" group="3"/>
        <site name="lidar_site" pos="0 0 0"
              size="0.006" rgba="0.05 0.9 1 1"/>
        <site name="lidar_raycast_site" pos="0 0 0.030"
              size="0.004" rgba="1 0.25 0.05 1"/>
      </body>

      <body name="left_tof_link" pos="0 0.236 0.075">
        <geom name="left_tof_body" type="box" size="0.015625 0.007675 0.004390"
              material="tof_body" density="0" contype="0" conaffinity="0"
              group="0"/>
        <geom name="left_tof_window" type="box" pos="0 0.008175 0"
              size="0.012000 0.000500 0.003200" material="tof_window"
              density="0" contype="0" conaffinity="0" group="0"/>
        <site name="left_tof_site" pos="0 0.009000 0"
              quat="0.7071068 0 0 0.7071068"
              size="0.006" rgba="1.0 0.75 0.1 1"/>
      </body>

      <body name="right_tof_link" pos="0 -0.236 0.075">
        <geom name="right_tof_body" type="box" size="0.015625 0.007675 0.004390"
              material="tof_body" density="0" contype="0" conaffinity="0"
              group="0"/>
        <geom name="right_tof_window" type="box" pos="0 -0.008175 0"
              size="0.012000 0.000500 0.003200" material="tof_window"
              density="0" contype="0" conaffinity="0" group="0"/>
        <site name="right_tof_site" pos="0 -0.009000 0"
              quat="0.7071068 0 0 -0.7071068"
              size="0.006" rgba="1.0 0.75 0.1 1"/>
      </body>

      <body name="front_left_steer_link" pos="0.225 0.225 -0.105">
        <joint name="front_left_steer_joint" class="steer_joint"/>
        <geom name="front_left_steer_post" type="cylinder" pos="0 0 0.060"
              size="0.035 0.060" material="module_metal" mass="0.4"
              contype="0" conaffinity="0" group="0"/>
        <body name="front_left_wheel_link">
          <joint name="front_left_wheel_joint" class="wheel_joint"/>
          <geom name="front_left_wheel" class="wheel_geom"/>
        </body>
      </body>

      <body name="front_right_steer_link" pos="0.225 -0.225 -0.105">
        <joint name="front_right_steer_joint" class="steer_joint"/>
        <geom name="front_right_steer_post" type="cylinder" pos="0 0 0.060"
              size="0.035 0.060" material="module_metal" mass="0.4"
              contype="0" conaffinity="0" group="0"/>
        <body name="front_right_wheel_link">
          <joint name="front_right_wheel_joint" class="wheel_joint"/>
          <geom name="front_right_wheel" class="wheel_geom"/>
        </body>
      </body>

      <body name="rear_left_steer_link" pos="-0.225 0.225 -0.105">
        <joint name="rear_left_steer_joint" class="steer_joint"/>
        <geom name="rear_left_steer_post" type="cylinder" pos="0 0 0.060"
              size="0.035 0.060" material="module_metal" mass="0.4"
              contype="0" conaffinity="0" group="0"/>
        <body name="rear_left_wheel_link">
          <joint name="rear_left_wheel_joint" class="wheel_joint"/>
          <geom name="rear_left_wheel" class="wheel_geom"/>
        </body>
      </body>

      <body name="rear_right_steer_link" pos="-0.225 -0.225 -0.105">
        <joint name="rear_right_steer_joint" class="steer_joint"/>
        <geom name="rear_right_steer_post" type="cylinder" pos="0 0 0.060"
              size="0.035 0.060" material="module_metal" mass="0.4"
              contype="0" conaffinity="0" group="0"/>
        <body name="rear_right_wheel_link">
          <joint name="rear_right_wheel_joint" class="wheel_joint"/>
          <geom name="rear_right_wheel" class="wheel_geom"/>
        </body>
      </body>

      <site name="imu_site" pos="0 0 0.095" size="0.015" rgba="0.1 0.8 0.4 1"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="front_left_wheel_link"/>
    <exclude body1="base_link" body2="front_right_wheel_link"/>
    <exclude body1="base_link" body2="rear_left_wheel_link"/>
    <exclude body1="base_link" body2="rear_right_wheel_link"/>
  </contact>

  <!-- Control order: 4 steering angles in rad, then 4 wheel speeds in rad/s. -->
  <actuator>
    <position name="front_left_steer_pos" joint="front_left_steer_joint"
              kp="240" kv="8" ctrlrange="-3.14159 3.14159" forcerange="-60 60"/>
    <position name="front_right_steer_pos" joint="front_right_steer_joint"
              kp="240" kv="8" ctrlrange="-3.14159 3.14159" forcerange="-60 60"/>
    <position name="rear_left_steer_pos" joint="rear_left_steer_joint"
              kp="240" kv="8" ctrlrange="-3.14159 3.14159" forcerange="-60 60"/>
    <position name="rear_right_steer_pos" joint="rear_right_steer_joint"
              kp="240" kv="8" ctrlrange="-3.14159 3.14159" forcerange="-60 60"/>

    <velocity name="front_left_wheel_vel" joint="front_left_wheel_joint"
              kv="240" ctrlrange="-60 60" forcerange="-40 40"/>
    <velocity name="front_right_wheel_vel" joint="front_right_wheel_joint"
              kv="240" ctrlrange="-60 60" forcerange="-40 40"/>
    <velocity name="rear_left_wheel_vel" joint="rear_left_wheel_joint"
              kv="240" ctrlrange="-60 60" forcerange="-40 40"/>
    <velocity name="rear_right_wheel_vel" joint="rear_right_wheel_joint"
              kv="240" ctrlrange="-60 60" forcerange="-40 40"/>
  </actuator>

  <sensor>
    <jointpos name="front_left_steer_pos_sensor" joint="front_left_steer_joint"/>
    <jointpos name="front_right_steer_pos_sensor" joint="front_right_steer_joint"/>
    <jointpos name="rear_left_steer_pos_sensor" joint="rear_left_steer_joint"/>
    <jointpos name="rear_right_steer_pos_sensor" joint="rear_right_steer_joint"/>

    <jointvel name="front_left_wheel_vel_sensor" joint="front_left_wheel_joint"/>
    <jointvel name="front_right_wheel_vel_sensor" joint="front_right_wheel_joint"/>
    <jointvel name="rear_left_wheel_vel_sensor" joint="rear_left_wheel_joint"/>
    <jointvel name="rear_right_wheel_vel_sensor" joint="rear_right_wheel_joint"/>

    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_accel" site="imu_site"/>
  </sensor>
</mujoco>
